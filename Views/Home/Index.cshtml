@section Scripts {
    <script src="~/js/dateUtils.js"></script>
    <script src="~/js/main.js"></script>
}


<div class="container mt-5">
    <h2 class="fw-bold">Ami Labs Zero</h2>

    <div class="card p-4 mt-3">

        <!-- INPUT -->
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#dateTool">Date Tool</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#jsonTool">JSON Viewer</a>
            </li>
        </ul>

        <div class="tab-content mt-3">

            <!-- DATE TOOL (ISI NYA DI SINI) -->
            <div id="dateTool" class="tab-pane fade show active">

                <div class="card p-3">

                    <label>Input (MM YYYY)</label>
                    <input type="text" id="inputPeriod" class="form-control" placeholder="02 2026" />

                    <button id="btnConvert" class="btn btn-primary mt-2">Convert</button>

                    <hr />

                    <p>Start Date: <b id="startDate"></b></p>
                    <p>End Date: <b id="endDate"></b></p>

                    <button id="btnCopy" class="btn btn-success mt-2">Copy</button>

                </div>

            </div>

            <!-- JSON TOOL -->
            <div id="jsonTool" class="tab-pane fade">

                <textarea id="jsonInput" class="form-control" rows="5"></textarea>

                <button id="btnFormatJson" class="btn btn-secondary mt-2">
                    Format JSON
                </button>

                <pre id="jsonOutput" class="mt-3"></pre>

                <hr />

                <!-- 🔥 EXCEL TO JSON -->
                <h5>📊 Excel → JSON</h5>

                <input type="file" id="excelFile" class="form-control mt-2" accept=".xlsx, .xls" />

                <button id="btnConvertExcel" class="btn btn-success mt-2">
                    Convert Excel
                </button>

                <!-- ✅ BUTTON DOWNLOAD -->
                <button id="btnDownloadJson" class="btn btn-primary mt-2">
                    ⬇️ Download JSON
                </button>

            </div>
        </div>
    </div>
</div>